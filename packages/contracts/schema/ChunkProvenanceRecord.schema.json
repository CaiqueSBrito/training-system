{
  "$defs": {
    "TextRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TextRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chunk_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Chunk Id",
      "type": "string"
    },
    "canonical_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Canonical Id"
    },
    "start": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Start"
    },
    "end": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "End"
    },
    "span_ids": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Span Ids",
      "type": "array"
    },
    "overlap_ranges": {
      "items": {
        "$ref": "#/$defs/TextRange"
      },
      "title": "Overlap Ranges",
      "type": "array"
    },
    "mapping_status": {
      "enum": [
        "exact",
        "insufficient"
      ],
      "title": "Mapping Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "chunk_id",
    "canonical_id",
    "start",
    "end",
    "span_ids",
    "overlap_ranges",
    "mapping_status",
    "created_at"
  ],
  "title": "ChunkProvenanceRecord",
  "type": "object"
}
