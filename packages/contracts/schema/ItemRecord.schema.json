{
  "$defs": {
    "BloomLevel": {
      "description": "Níveis da taxonomia de Bloom revisada (RAG-PLN-001).",
      "enum": [
        "lembrar",
        "compreender",
        "aplicar",
        "analisar",
        "avaliar",
        "criar"
      ],
      "title": "BloomLevel",
      "type": "string"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "Citação de um item: `chunk_ref` do contexto e evidência literal curta (RAG-GEN-002).",
      "properties": {
        "chunk_ref": {
          "description": "Referência ao chunk no contexto numerado da geração: C1, C2, ...",
          "examples": [
            "C3"
          ],
          "pattern": "^C[1-9][0-9]*$",
          "title": "Chunk Ref",
          "type": "string"
        },
        "evidence": {
          "description": "Trecho literal curto da fonte.",
          "pattern": "\\S",
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "chunk_ref",
        "evidence"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Flashcard": {
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "const": "flashcard",
          "title": "Tipo",
          "type": "string"
        },
        "front": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Front",
          "type": "string"
        },
        "back": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Back",
          "type": "string"
        },
        "bloom_level": {
          "$ref": "#/$defs/BloomLevel"
        },
        "citations": {
          "description": "Ao menos uma citação.",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "tipo",
        "front",
        "back",
        "bloom_level",
        "citations"
      ],
      "title": "Flashcard",
      "type": "object"
    },
    "ItemStatus": {
      "enum": [
        "entregue",
        "omitido"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "JsonValue": {},
    "MotivoRejeicao": {
      "description": "Motivos de rejeição ou omissão de um item (E9, E10, E11).",
      "enum": [
        "sem_citacao",
        "citacao_inexistente",
        "evidencia_nao_encontrada",
        "questao_mal_formada",
        "duplicata",
        "vazio_ou_trivial",
        "reprovado_no_juiz_de_saida",
        "violacao_de_schema"
      ],
      "title": "MotivoRejeicao",
      "type": "string"
    },
    "Question": {
      "additionalProperties": false,
      "description": "Questão de múltipla escolha. Invariantes: ≥ 2 alternativas únicas e `correct_index` válido.",
      "properties": {
        "tipo": {
          "const": "question",
          "title": "Tipo",
          "type": "string"
        },
        "stem": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Stem",
          "type": "string"
        },
        "options": {
          "items": {
            "description": "Texto com ao menos um caractere visível.",
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "correct_index": {
          "minimum": 0,
          "title": "Correct Index",
          "type": "integer"
        },
        "explanation": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "bloom_level": {
          "$ref": "#/$defs/BloomLevel"
        },
        "citations": {
          "description": "Ao menos uma citação.",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "tipo",
        "stem",
        "options",
        "correct_index",
        "explanation",
        "bloom_level",
        "citations"
      ],
      "title": "Question",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Item produzido no turno (§7): conteúdo bruto sempre; conteúdo validado quando existe.\n\n- `raw_content`: o item como recebido da geração (mesmo inválido);\n- `content`: o `Item` estrito (após reparo, se houve); obrigatório se entregue;\n- `motivo` se e somente se omitido; sem `content`, só motivos de `MOTIVOS_SEM_ITEM_VALIDO`.",
  "properties": {
    "item_id": {
      "description": "Identificador opaco do registro.",
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "chat_turn_id": {
      "description": "Identificador opaco do registro.",
      "minLength": 1,
      "title": "Chat Turn Id",
      "type": "string"
    },
    "raw_content": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Item como recebido da geração, ainda não validado contra `Item`.",
      "title": "Raw Content",
      "type": "object"
    },
    "content": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "flashcard": "#/$defs/Flashcard",
              "question": "#/$defs/Question"
            },
            "propertyName": "tipo"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Flashcard"
            },
            {
              "$ref": "#/$defs/Question"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content"
    },
    "status": {
      "$ref": "#/$defs/ItemStatus"
    },
    "motivo": {
      "anyOf": [
        {
          "$ref": "#/$defs/MotivoRejeicao"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "item_id",
    "chat_turn_id",
    "raw_content",
    "status"
  ],
  "title": "ItemRecord",
  "type": "object"
}
