{
  "$defs": {
    "BloomLevel": {
      "description": "Níveis da taxonomia de Bloom revisada (RAG-PLN-001).",
      "enum": [
        "lembrar",
        "compreender",
        "aplicar",
        "analisar",
        "avaliar",
        "criar"
      ],
      "title": "BloomLevel",
      "type": "string"
    },
    "ChatStatus": {
      "enum": [
        "ok",
        "recusa",
        "fora_de_escopo",
        "conteudo_insuficiente",
        "erro"
      ],
      "title": "ChatStatus",
      "type": "string"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "Citação de um item: `chunk_ref` do contexto e evidência literal curta (RAG-GEN-002).",
      "properties": {
        "chunk_ref": {
          "description": "Referência ao chunk no contexto numerado da geração: C1, C2, ...",
          "examples": [
            "C3"
          ],
          "pattern": "^C[1-9][0-9]*$",
          "title": "Chunk Ref",
          "type": "string"
        },
        "evidence": {
          "description": "Trecho literal curto da fonte.",
          "pattern": "\\S",
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "chunk_ref",
        "evidence"
      ],
      "title": "Citation",
      "type": "object"
    },
    "DeliveredItem": {
      "additionalProperties": false,
      "description": "Item entregue, com o ID que permite navegar a linhagem (OBS-LIN-001).",
      "properties": {
        "item_id": {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "conteudo": {
          "discriminator": {
            "mapping": {
              "flashcard": "#/$defs/Flashcard",
              "question": "#/$defs/Question"
            },
            "propertyName": "tipo"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Flashcard"
            },
            {
              "$ref": "#/$defs/Question"
            }
          ],
          "title": "Conteudo"
        }
      },
      "required": [
        "item_id",
        "conteudo"
      ],
      "title": "DeliveredItem",
      "type": "object"
    },
    "Flashcard": {
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "const": "flashcard",
          "title": "Tipo",
          "type": "string"
        },
        "front": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Front",
          "type": "string"
        },
        "back": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Back",
          "type": "string"
        },
        "bloom_level": {
          "$ref": "#/$defs/BloomLevel"
        },
        "citations": {
          "description": "Ao menos uma citação.",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "tipo",
        "front",
        "back",
        "bloom_level",
        "citations"
      ],
      "title": "Flashcard",
      "type": "object"
    },
    "MotivoRecusa": {
      "description": "Motivos de recusa de E1 (higiene) e E2 (juiz de entrada, com falha fechada).",
      "enum": [
        "tamanho_excedido",
        "limite_de_taxa",
        "prompt_malicioso",
        "falha_do_juiz_de_entrada"
      ],
      "title": "MotivoRecusa",
      "type": "string"
    },
    "MotivoRejeicao": {
      "description": "Motivos de rejeição ou omissão de um item (E9, E10, E11).",
      "enum": [
        "sem_citacao",
        "citacao_inexistente",
        "evidencia_nao_encontrada",
        "questao_mal_formada",
        "duplicata",
        "vazio_ou_trivial",
        "reprovado_no_juiz_de_saida",
        "violacao_de_schema"
      ],
      "title": "MotivoRejeicao",
      "type": "string"
    },
    "Omission": {
      "additionalProperties": false,
      "description": "Item omitido da resposta, com o motivo (RAG-JUI-003).",
      "properties": {
        "item_id": {
          "anyOf": [
            {
              "description": "Identificador opaco do registro.",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "motivo": {
          "$ref": "#/$defs/MotivoRejeicao"
        },
        "detalhe": {
          "anyOf": [
            {
              "description": "Texto com ao menos um caractere visível.",
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detalhe"
        }
      },
      "required": [
        "motivo"
      ],
      "title": "Omission",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "description": "Questão de múltipla escolha. Invariantes: ≥ 2 alternativas únicas e `correct_index` válido.",
      "properties": {
        "tipo": {
          "const": "question",
          "title": "Tipo",
          "type": "string"
        },
        "stem": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Stem",
          "type": "string"
        },
        "options": {
          "items": {
            "description": "Texto com ao menos um caractere visível.",
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "correct_index": {
          "minimum": 0,
          "title": "Correct Index",
          "type": "integer"
        },
        "explanation": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "bloom_level": {
          "$ref": "#/$defs/BloomLevel"
        },
        "citations": {
          "description": "Ao menos uma citação.",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "tipo",
        "stem",
        "options",
        "correct_index",
        "explanation",
        "bloom_level",
        "citations"
      ],
      "title": "Question",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Fonte citada por um item entregue, com o `chunk_ref` local resolvido (E12, OBS-LIN-001).",
      "properties": {
        "chunk_ref": {
          "description": "Referência ao chunk no contexto numerado da geração: C1, C2, ...",
          "examples": [
            "C3"
          ],
          "pattern": "^C[1-9][0-9]*$",
          "title": "Chunk Ref",
          "type": "string"
        },
        "chunk_id": {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_version_id": {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "title": "Document Version Id",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        }
      },
      "required": [
        "chunk_ref",
        "chunk_id",
        "document_id",
        "document_version_id"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Resposta do chat (E12: \"resposta com fontes\").\n\nSó `ok` leva itens, omissões e fontes; só `recusa` leva `motivo_recusa`. `fontes` traz\nexatamente os `chunk_ref` citados pelos itens entregues, um por ref.",
  "properties": {
    "status": {
      "$ref": "#/$defs/ChatStatus"
    },
    "mensagem": {
      "default": "",
      "description": "Texto exibido ao usuário.",
      "title": "Mensagem",
      "type": "string"
    },
    "itens": {
      "items": {
        "$ref": "#/$defs/DeliveredItem"
      },
      "title": "Itens",
      "type": "array"
    },
    "omissoes": {
      "items": {
        "$ref": "#/$defs/Omission"
      },
      "title": "Omissoes",
      "type": "array"
    },
    "fontes": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Fontes",
      "type": "array"
    },
    "motivo_recusa": {
      "anyOf": [
        {
          "$ref": "#/$defs/MotivoRecusa"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "chat_turn_id": {
      "anyOf": [
        {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chat Turn Id"
    },
    "trace_id": {
      "anyOf": [
        {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    }
  },
  "required": [
    "status"
  ],
  "title": "ChatResponse",
  "type": "object"
}
