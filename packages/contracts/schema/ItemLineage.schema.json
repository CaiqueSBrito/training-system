{
  "$defs": {
    "BloomLevel": {
      "description": "Níveis da taxonomia de Bloom revisada (RAG-PLN-001).",
      "enum": [
        "lembrar",
        "compreender",
        "aplicar",
        "analisar",
        "avaliar",
        "criar"
      ],
      "title": "BloomLevel",
      "type": "string"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "Citação de um item: `chunk_ref` do contexto e evidência literal curta (RAG-GEN-002).",
      "properties": {
        "chunk_ref": {
          "description": "Referência ao chunk no contexto numerado da geração: C1, C2, ...",
          "examples": [
            "C3"
          ],
          "pattern": "^C[1-9][0-9]*$",
          "title": "Chunk Ref",
          "type": "string"
        },
        "evidence": {
          "description": "Trecho literal curto da fonte.",
          "pattern": "\\S",
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "chunk_ref",
        "evidence"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CitationLineage": {
      "additionalProperties": false,
      "description": "Uma citação do item resolvida até o documento (OBS-LIN-001).",
      "properties": {
        "citation_id": {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "title": "Citation Id",
          "type": "string"
        },
        "chunk_ref": {
          "description": "Referência ao chunk no contexto numerado da geração: C1, C2, ...",
          "examples": [
            "C3"
          ],
          "pattern": "^C[1-9][0-9]*$",
          "title": "Chunk Ref",
          "type": "string"
        },
        "chunk_id": {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "evidence": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Evidence",
          "type": "string"
        },
        "document_id": {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_version_id": {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "title": "Document Version Id",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        }
      },
      "required": [
        "citation_id",
        "chunk_ref",
        "chunk_id",
        "evidence",
        "document_id",
        "document_version_id"
      ],
      "title": "CitationLineage",
      "type": "object"
    },
    "Flashcard": {
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "const": "flashcard",
          "title": "Tipo",
          "type": "string"
        },
        "front": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Front",
          "type": "string"
        },
        "back": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Back",
          "type": "string"
        },
        "bloom_level": {
          "$ref": "#/$defs/BloomLevel"
        },
        "citations": {
          "description": "Ao menos uma citação.",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "tipo",
        "front",
        "back",
        "bloom_level",
        "citations"
      ],
      "title": "Flashcard",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "description": "Questão de múltipla escolha. Invariantes: ≥ 2 alternativas únicas e `correct_index` válido.",
      "properties": {
        "tipo": {
          "const": "question",
          "title": "Tipo",
          "type": "string"
        },
        "stem": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Stem",
          "type": "string"
        },
        "options": {
          "items": {
            "description": "Texto com ao menos um caractere visível.",
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "correct_index": {
          "minimum": 0,
          "title": "Correct Index",
          "type": "integer"
        },
        "explanation": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "bloom_level": {
          "$ref": "#/$defs/BloomLevel"
        },
        "citations": {
          "description": "Ao menos uma citação.",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "tipo",
        "stem",
        "options",
        "correct_index",
        "explanation",
        "bloom_level",
        "citations"
      ],
      "title": "Question",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Resposta da consulta de linhagem pelo ID de um item entregue (OBS-LIN-001).\n\nitem → citação → chunk → documento/versão/página/seção, e item → `trace_id` (Langfuse).\n`citations` corresponde às citações do conteúdo: mesmos pares (`chunk_ref`, `evidence`).",
  "properties": {
    "item_id": {
      "description": "Identificador opaco do registro.",
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "chat_turn_id": {
      "description": "Identificador opaco do registro.",
      "minLength": 1,
      "title": "Chat Turn Id",
      "type": "string"
    },
    "trace_id": {
      "description": "Identificador opaco do registro.",
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "content": {
      "discriminator": {
        "mapping": {
          "flashcard": "#/$defs/Flashcard",
          "question": "#/$defs/Question"
        },
        "propertyName": "tipo"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Flashcard"
        },
        {
          "$ref": "#/$defs/Question"
        }
      ],
      "title": "Content"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/CitationLineage"
      },
      "minItems": 1,
      "title": "Citations",
      "type": "array"
    }
  },
  "required": [
    "item_id",
    "chat_turn_id",
    "trace_id",
    "content",
    "citations"
  ],
  "title": "ItemLineage",
  "type": "object"
}
