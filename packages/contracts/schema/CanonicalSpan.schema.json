    },
    "end": {
      "minimum": 0,
      "title": "End",
      "type": "integer"
    },
    "span_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Span Id",
      "type": "string"
    },
    "canonical_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Canonical Id",
      "type": "string"
