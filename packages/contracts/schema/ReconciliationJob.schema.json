{
  "additionalProperties": false,
  "description": "Checkpoint de negócio correlacionado a job Procrastinate, sem fila própria.",
  "properties": {
    "job_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Job Id",
      "type": "string"
    },
    "owner_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Owner Id",
      "type": "string"
    },
    "document_version_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Document Version Id",
      "type": "string"
    },
    "embedding_key": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Embedding Key",
      "type": "string"
    },
    "desired_revision": {
      "minimum": 1,
      "title": "Desired Revision",
      "type": "integer"
    },
    "cursor": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cursor"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "state": {
      "enum": [
        "pending",
        "running",
        "retry",
        "complete",
        "blocked"
      ],
      "title": "State",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "provider",
            "invalid_output",
            "timeout",
            "configuration",
            "storage",
            "conflict",
            "stale_generation",
            "legacy_insufficient",
            "index_divergent"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "owner_id",
    "document_version_id",
    "embedding_key",
    "desired_revision",
    "cursor",
    "attempt",
    "state",
    "error_code",
    "created_at"
  ],
  "title": "ReconciliationJob",
  "type": "object"
}
