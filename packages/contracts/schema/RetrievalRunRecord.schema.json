{
  "$defs": {
    "RetrievalCandidate": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "rrf_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ausente no modo cobertura.",
          "title": "Rrf Score"
        },
        "rerank_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank Score"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        }
      },
      "required": [
        "chunk_id",
        "selected"
      ],
      "title": "RetrievalCandidate",
      "type": "object"
    },
    "RetrievalMode": {
      "description": "Modos de recuperação decididos em E3 (arquitetura §2.1).",
      "enum": [
        "cobertura",
        "consulta"
      ],
      "title": "RetrievalMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "retrieval_run_id": {
      "description": "Identificador opaco do registro.",
      "minLength": 1,
      "title": "Retrieval Run Id",
      "type": "string"
    },
    "chat_turn_id": {
      "description": "Identificador opaco do registro.",
      "minLength": 1,
      "title": "Chat Turn Id",
      "type": "string"
    },
    "modo": {
      "$ref": "#/$defs/RetrievalMode"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/RetrievalCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "cutoff": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Corte de score do reranker aplicado em E7.",
      "title": "Cutoff"
    }
  },
  "required": [
    "retrieval_run_id",
    "chat_turn_id",
    "modo",
    "candidates"
  ],
  "title": "RetrievalRunRecord",
  "type": "object"
}
