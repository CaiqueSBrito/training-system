{
  "$defs": {
    "BloomLevel": {
      "description": "Níveis da taxonomia de Bloom revisada (RAG-PLN-001).",
      "enum": [
        "lembrar",
        "compreender",
        "aplicar",
        "analisar",
        "avaliar",
        "criar"
      ],
      "title": "BloomLevel",
      "type": "string"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "Citação de um item: `chunk_ref` do contexto e evidência literal curta (RAG-GEN-002).",
      "properties": {
        "chunk_ref": {
          "description": "Referência ao chunk no contexto numerado da geração: C1, C2, ...",
          "examples": [
            "C3"
          ],
          "pattern": "^C[1-9][0-9]*$",
          "title": "Chunk Ref",
          "type": "string"
        },
        "evidence": {
          "description": "Trecho literal curto da fonte.",
          "pattern": "\\S",
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "chunk_ref",
        "evidence"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Flashcard": {
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "const": "flashcard",
          "title": "Tipo",
          "type": "string"
        },
        "front": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Front",
          "type": "string"
        },
        "back": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Back",
          "type": "string"
        },
        "bloom_level": {
          "$ref": "#/$defs/BloomLevel"
        },
        "citations": {
          "description": "Ao menos uma citação.",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "tipo",
        "front",
        "back",
        "bloom_level",
        "citations"
      ],
      "title": "Flashcard",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "description": "Questão de múltipla escolha. Invariantes: ≥ 2 alternativas únicas e `correct_index` válido.",
      "properties": {
        "tipo": {
          "const": "question",
          "title": "Tipo",
          "type": "string"
        },
        "stem": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Stem",
          "type": "string"
        },
        "options": {
          "items": {
            "description": "Texto com ao menos um caractere visível.",
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "correct_index": {
          "minimum": 0,
          "title": "Correct Index",
          "type": "integer"
        },
        "explanation": {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "bloom_level": {
          "$ref": "#/$defs/BloomLevel"
        },
        "citations": {
          "description": "Ao menos uma citação.",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "tipo",
        "stem",
        "options",
        "correct_index",
        "explanation",
        "bloom_level",
        "citations"
      ],
      "title": "Question",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Formato pedido ao agente de geração (E8): o `response_schema` da chamada.\n\nValida o lote inteiro de uma vez. Para processar a saída recebida item a item, use\n`RawGenerationOutput`.",
  "properties": {
    "itens": {
      "items": {
        "discriminator": {
          "mapping": {
            "flashcard": "#/$defs/Flashcard",
            "question": "#/$defs/Question"
          },
          "propertyName": "tipo"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Flashcard"
          },
          {
            "$ref": "#/$defs/Question"
          }
        ]
      },
      "title": "Itens",
      "type": "array"
    }
  },
  "required": [
    "itens"
  ],
  "title": "GenerationOutput",
  "type": "object"
}
