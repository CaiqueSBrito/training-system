{
  "$defs": {
    "MotivoRejeicao": {
      "description": "Motivos de rejeição ou omissão de um item (E9, E10, E11).",
      "enum": [
        "sem_citacao",
        "citacao_inexistente",
        "evidencia_nao_encontrada",
        "questao_mal_formada",
        "duplicata",
        "vazio_ou_trivial",
        "reprovado_no_juiz_de_saida",
        "violacao_de_schema"
      ],
      "title": "MotivoRejeicao",
      "type": "string"
    },
    "VerdictOrigin": {
      "enum": [
        "E9",
        "E10"
      ],
      "title": "VerdictOrigin",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Veredito de E9 ou E10 sobre um item (§7). Invariantes conforme a origem:\n\n- reprovado exige `motivo`; aprovado não tem `motivo`;\n- E9: motivo de `MOTIVOS_E9`, sem `judge_model` nem rubricas; aprovado também sem `detalhe`;\n- E10: `judge_model`, `fundamentado` e `conforme_rubrica` obrigatórios, `aprovado` = ambos;\n  reprovado tem motivo `reprovado_no_juiz_de_saida` e o motivo do juiz em `detalhe`.",
  "properties": {
    "verdict_id": {
      "description": "Identificador opaco do registro.",
      "minLength": 1,
      "title": "Verdict Id",
      "type": "string"
    },
    "item_id": {
      "description": "Identificador opaco do registro.",
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "origem": {
      "$ref": "#/$defs/VerdictOrigin"
    },
    "tentativa": {
      "default": 1,
      "description": "1 = geração original; 2 = após o reparo (RAG-JUI-003).",
      "maximum": 2,
      "minimum": 1,
      "title": "Tentativa",
      "type": "integer"
    },
    "aprovado": {
      "title": "Aprovado",
      "type": "boolean"
    },
    "motivo": {
      "anyOf": [
        {
          "$ref": "#/$defs/MotivoRejeicao"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "detalhe": {
      "anyOf": [
        {
          "description": "Texto com ao menos um caractere visível.",
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detalhe"
    },
    "fundamentado": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Só E10: groundedness.",
      "title": "Fundamentado"
    },
    "conforme_rubrica": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Só E10: rubrica de viés/padrão.",
      "title": "Conforme Rubrica"
    },
    "judge_model": {
      "anyOf": [
        {
          "description": "Identificador opaco do registro.",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Obrigatório em E10; ausente em E9.",
      "title": "Judge Model"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "verdict_id",
    "item_id",
    "origem",
    "aprovado",
    "created_at"
  ],
  "title": "VerdictRecord",
  "type": "object"
}
