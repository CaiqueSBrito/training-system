# Copie para .env e preencha. Nunca versione o .env.

# Google AI Studio — geração, classificador, pedagógico, juiz de entrada, embeddings
GEMINI_API_KEY=
GENERATION_MODEL=gemini-3.1-flash-lite
# Fonte dos prompts do chat (ADR-0016); única suportada: offline (artefatos versionados no pacote)
PROMPT_SOURCE=offline
INPUT_JUDGE_MODEL=gemini/gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072
EMBEDDING_FORMAT_VERSION=fmt-v1

# OpenRouter — juiz de saída e juiz do RAGAS (via LiteLLM)
OPENROUTER_API_KEY=
OUTPUT_JUDGE_MODEL=openrouter/anthropic/claude-haiku-5.5
EVAL_JUDGE_MODEL=openrouter/openai/gpt-6.1-sol

# Qdrant (ADR-0002)
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Postgres da aplicação — linhagem (ADR-0008, separado do Langfuse)
APP_POSTGRES_PORT=5432
APP_POSTGRES_DB=training_system
APP_POSTGRES_USER=training_app
APP_POSTGRES_PASSWORD=

# Reranker local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Langfuse — credenciais do SDK e host local (ADR-0005)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Langfuse self-hosted — infraestrutura local (preencha segredos no .env)
LANGFUSE_PORT=3000
LANGFUSE_WORKER_PORT=3030
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Gere 64 caracteres hexadecimais (256 bits): openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=

# Langfuse — inicialização headless opcional (usa LANGFUSE_PUBLIC_KEY e LANGFUSE_SECRET_KEY)
LANGFUSE_INIT_ORG_ID=training-system-org
LANGFUSE_INIT_ORG_NAME="Training System"
LANGFUSE_INIT_PROJECT_ID=training-system-local
LANGFUSE_INIT_PROJECT_NAME="Training System Local"
LANGFUSE_INIT_USER_EMAIL=admin@training-system.local
LANGFUSE_INIT_USER_NAME="Admin Local"
LANGFUSE_INIT_USER_PASSWORD=

# Langfuse — Postgres próprio (banco e credenciais distintos de APP_POSTGRES_*)
LANGFUSE_POSTGRES_PORT=5433
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=

# Langfuse — ClickHouse, Redis e MinIO
LANGFUSE_CLICKHOUSE_HTTP_PORT=8123
LANGFUSE_CLICKHOUSE_NATIVE_PORT=9000
LANGFUSE_CLICKHOUSE_DB=default
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PORT=6379
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_API_PORT=9090
LANGFUSE_MINIO_CONSOLE_PORT=9091
LANGFUSE_MINIO_ROOT_USER=minio
LANGFUSE_MINIO_ROOT_PASSWORD=

# Juiz da ingestão (LiteLLM); vazio reutiliza INPUT_JUDGE_MODEL
INGESTION_JUDGE_MODEL=

# API — autenticação própria (ADR-0017)
API_COOKIE_SECURE=true
API_SESSION_LIFETIME_SECONDS=604800
API_PASSWORD_MIN_LENGTH=12
API_LOGIN_MAX_FAILURES_PER_ACCOUNT=5
API_LOGIN_MAX_FAILURES_PER_ORIGIN=20
API_LOGIN_WINDOW_SECONDS=900
API_REGISTER_MAX_PER_ORIGIN=5
API_REGISTER_WINDOW_SECONDS=3600
# Obrigatório: gere um segredo aleatório local; HMAC das chaves de tentativa.
API_ATTEMPT_KEY_SECRET=
# Expiração também por inatividade (60 minutos); toque no máximo uma vez/minuto.
API_SESSION_IDLE_SECONDS=3600
# Desliga /docs e /redoc quando false; /openapi.json permanece disponível.
API_DOCS_ENABLED=true
# Argon2: concorrência máxima; vazio usa max(2, número de núcleos).
# Defina um inteiro positivo para limitar conforme os recursos do servidor.
API_PASSWORD_HASH_CONCURRENCY=
