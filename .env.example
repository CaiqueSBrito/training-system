# Copie para .env e preencha. Nunca versione o .env.

# Google AI Studio — geração, classificador, pedagógico, juiz de entrada, embeddings
GEMINI_API_KEY=
GENERATION_MODEL=gemini-3.1-flash-lite
INPUT_JUDGE_MODEL=gemini/gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072
EMBEDDING_FORMAT_VERSION=fmt-v1

# OpenRouter — juiz de saída e juiz do RAGAS (via LiteLLM)
OPENROUTER_API_KEY=
OUTPUT_JUDGE_MODEL=openrouter/anthropic/claude-haiku-5.5
EVAL_JUDGE_MODEL=openrouter/openai/gpt-6.1-sol

# Qdrant
QDRANT_URL=

# Reranker local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
